{
  "_version": "1.51.0",
  "sap.app": {
    "id": "zfiexpensesmanage",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.13.3",
      "toolsId": "db226d09-5d27-41dc-a405-13732cb7d503"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/ZFI_EXPENSES_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [
            "ZFI_EXPENSES_ANNO_MDL",
            "annotation"
          ],
          "localUri": "localService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "ZFI_EXPENSES_ANNO_MDL": {
        "uri": "/zsrv_iwfnd/Annotations(TechnicalName='ZFI_EXPENSES_ANNO_MDL',Version='0001')/$value/",
        "type": "ODataAnnotation",
        "settings": {
          "localUri": "localService/ZFI_EXPENSES_ANNO_MDL.xml"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.111.8",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {},
        "sap.ui.comp": {},
        "sap.ui.generic.app": {},
        "sap.ui.table": {},
        "sap.ushell": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zfiexpensesmanage.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {}
      }
    },
    "resources": {},
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "async": true,
        "viewPath": "zfiexpensesmanage.view",
        "controlAggregation": "beginColumnPages",
        "controlId": "layout"
      },
      "routes": [
        {
          "name": "RouteMain",
          "pattern": "",
          "target": "TargetMain"
        },
        {
          "pattern": "ZFI_EXPENSES_MNG/{objectId}",
          "name": "Detail",
          "target": [
            "TargetMain",
            "Detail"
          ]
        },
        {
          "name": "NotFound",
          "pattern": "NotFound",
          "target": "NotFound"
        }
      ],
      "targets": {
        "TargetMain": {
          "viewType": "XML",
          "transition": "slide",
          "viewLevel": 1,
          "viewId": "Main",
          "viewName": "Main"
        },
        "Detail": {
          "viewName": "Detail",
          "transition": "slide",
          "viewLevel": 1,
          "controlAggregation": "midColumnPages",
          "viewId": "Detail"
        },
        "NotFound": {
          "viewName": "NotFound",
          "viewType": "XML",
          "transition": "show",
          "clearControlAggregation": false,
          "viewId": "NotFound"
        }
      }
    },
    "rootView": {
      "viewName": "zfiexpensesmanage.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  }
}