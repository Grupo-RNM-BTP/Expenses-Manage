<core:FragmentDefinition xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:tnt="sap.tnt">
    <Dialog id="expenseDialog" title="{i18n>xexp.expNewExpTitle}" afterClose="onCancelProcess(true)" contentWidth="40rem" contentHeight="42rem" horizontalScrolling="false" verticalScrolling="false" resizable="false" draggable="false" closeOnNavigation="true" busyIndicatorDelay="1000" busyIndicatorSize="Medium">

        <Page id="detail" backgroundDesign="List" titleLevel="Auto" showNavButton="false" showHeader="false" showSubHeader="true" enableScrolling="true" showFooter="true" contentOnlyBusy="false" floatingFooter="false" titleAlignment="Auto">

            <ObjectHeader title="{i18n>xexp.expDraft}" iconDensityAware="true" imageShape="Square" titleTextDirection="Inherit" introTextDirection="Inherit" numberTextDirection="Inherit" titleLevel="H3"/>

            <VBox direction="Column" fitContainer="false" renderType="Div" justifyContent="Start" alignItems="Stretch" wrap="NoWrap" alignContent="Stretch" backgroundDesign="Transparent">
                <f:SimpleForm id="sfGeneral" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXl="2" columnsL="1" columnsM="1" singleContainerFullSize="false" breakpointXL="1440" breakpointL="1024" breakpointM="600" backgroundDesign="Translucent">
                    <f:content>
                        <Label text="" visible="false"/>
                        <Title text="{i18n>xexp.expGenTitle}"/>

                        <Label text="{i18n>xexp.expNo}"/>
                        <Input id="expenseDialog:inputExpNo" required="true"/>

                        <Label text="{i18n>xexp.expLocal}"/>
                        <Input id="expenseDialog:inputLocal" required="true"/>

                        <Label text="{i18n>xexp.expDate}"/>
                        <DatePicker id="expenseDialog:datePicker" valueFormat="yyyyMMdd" displayFormat="dd/MM/yyyy" required="true"/>

                        <Label text="{i18n>xexp.expNif}"/>
                        <Input id="expenseDialog:inputNif" liveChange=".onStripSpaces" required="true"/>

                        <Label text="{i18n>xexp.expCountry}"/>
                        <Select id="expenseDialog:selectCountry" items="{ path: '/ZFI_EXPENSES_COUNTRIES', length:500 }" required="true" change=".onCountryChange">
                            <items>
                                <core:Item key="{Country}" text="{Description}" />
                            </items>
                        </Select>
                    </f:content>
                </f:SimpleForm>

                <core:InvisibleText text=""/>

                <f:SimpleForm id="sfTech" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="4" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="4" emptySpanM="0" emptySpanS="0" columnsXl="2" columnsL="1" columnsM="1" singleContainerFullSize="false" breakpointXL="1440" breakpointL="1024" breakpointM="600" backgroundDesign="Translucent">
                    <f:content>
                        <Label text="" visible="false"/>
                        <Title text="{i18n>xexp.expTechTitle}"/>

                        <Label text="{i18n>xexp.expType}"/>
                        <Select id="expenseDialog:selectExpType" selectedKey="{Expenses>/exptype}" required="true" change=".onExpTypeChange">
                            <items>
                                <core:Item key="{Exptype}" text="{Description}" />
                            </items>
                        </Select>

                        <Label text="{i18n>xexp.expSubType}"/>
                        <Select id="expenseDialog:selectExpSubType" items="{ path: '/ZFI_EXPENSES_SUBTYPE' }" visible="{= (${Expenses>/exptype} || '').indexOf('REF') > -1 }" required="true">
                            <items>
                                <core:Item key="{ExpSubType}" text="{Description}" />
                            </items>
                        </Select>

                        <Label text="{i18n>xexp.expBP}"/>
                        <Input id="expenseDialog:selectBP" showValueHelp="true" valueHelpRequest="handleOpenPartnerVH" required="true" visible="{= ['DESPREP','UE'].indexOf((${Expenses>/exptype} || '')) > -1 }">
                            <customData>
                                <core:CustomData key="BPKey" value=""/>
                            </customData>
                            <suggestionItems>
                                <core:Item key="{BusinessPartner}" text="{BusinessPartnerName}" />
                            </suggestionItems>
                        </Input>

                        <Label text="{i18n>xexp.expPlate}"/>
                        <Input id="expenseDialog:inputPlate" visible="{= ((${Expenses>/exptype} || '').indexOf('LAVCIS')  > -1)  
                                                                      || ((${Expenses>/exptype} || '').indexOf('LAVCISE') > -1)  
                                                                      || ((${Expenses>/exptype} || '').indexOf('MANVTR')  > -1)
                                                                      || ((${Expenses>/exptype} || '').indexOf('COMBST')  > -1)
                                                                      || ((${Expenses>/exptype} || '').indexOf('PORTA')  > -1)
                                                                      || ((${Expenses>/exptype} || '').indexOf('ESTACI')  > -1)  
                                                                      || ((${Expenses>/exptype} || '').indexOf('UE')  > -1)  
                                                                      || ((${Expenses>/exptype} || '').indexOf('ADR')  > -1) }" liveChange=".onStripSpaces" required="true"/>

                        <Label text="{i18n>xexp.expFuelQuantity}"/>
                        <Input id="expenseDialog:inputFuelQuantity" type="Number" visible="{= (${Expenses>/exptype} || '').indexOf('COMBST') > -1 || (${Expenses>/exptype} || '').indexOf('UE') > -1 }" required="true"/>

                        <Label text="{i18n>xexp.expPymtMeth}"/>
                        <Select id="expenseDialog:selectPymtMeth" items="{ path: '/ZFI_EXPENSES_PYMTMETH' }" change=".onPymtMethChange" required="true">
                            <items>
                                <core:Item key="{Zlsch}" text="{Text2}" />
                            </items>
                        </Select>

                        <Label text="{i18n>xexp.expCreditCard}"/>
                        <Select id="expenseDialog:selectCreditCard" visible="{Cards>/hasData}" items="{Cards>/items}" required="true">
                            <items>
                                <core:Item key="{Cards>Cardnumber}" text="{Cards>Cardnumber}" />
                            </items>
                        </Select>

                        <Label id="expenseDialog:labelAmt" text="{i18n>xexp.expValue2}"/>
                        <Input id="expenseDialog:inputAmt" type="Number" required="true"/>

                        <Label id="expenseDialog:labelCurrency" text="{i18n>xexp.expCurrency}"/>
                        <Select id="expenseDialog:selectCurrency" items="{ path: '/ZFI_CURRENCY2', length:500 }" required="true">
                            <items>
                                <core:Item key="{Currency}" text="{CurrencyText}" />
                            </items>
                        </Select>

                        <Label id="expenseDialog:labelComments" text="{i18n>xexp.expComments}"/>
                        <TextArea id="expenseDialog:textAreaComments" />

                        <Label text="{i18n>xexp.expUnit}" visible="{Expenses>/unitVisible}"/>
                        <StepInput id="expenseDialog:inputUnit" min="1" max="100" step="1" value="1" visible="{Expenses>/unitVisible}" change=".onUnitChange" textAlign="Center" width="120px"/>

                        <Label id="expenseDialog:labelCollaborators" text="{i18n>xexp.expCollaborators}" visible="{Collaborators>/showCollaborators}"/>
                        <MultiInput id="expenseDialog:multiCollaborators" visible="{Collaborators>/showCollaborators}" showValueHelp="true" valueHelpRequest=".handleOpenCollaboratorsVH" showSuggestion="true" filterSuggests="false" suggest=".onSuggestCollaborators" suggestionItemSelected=".onCollaboratorSuggestionItemSelected" placeholder="{i18n>xexp.expCollaboratorsPlaceholder}" width="100%" suggestionItems="{ path: '/ZFI_MANAGER_VH', length: 50 }" required="true">
                            <suggestionItems>
                                <core:Item key="{pernr}" text="{cname}" />
                            </suggestionItems>
                        </MultiInput>

                        <Label text="" visible="false"/>
                        <Title id="expenseDialog:titleVatTable" text="{i18n>xexp.expVatTable}" level="H6" class="sapUiSmallMarginTop"/>

                        <Label text="" visible="false"/>
                        <Table id="expenseDialog:vatTable" items="{path: 'Expenses>/vatLines'}" width="auto">
                            <headerToolbar>
                                <Toolbar>
                                    <Button icon="sap-icon://add" type="Transparent" visible="{Expenses>/vatEditMode}" press=".onAddVatLine"/>
                                    <ToolbarSpacer/>
                                    <Button text="Editar" visible="{= !${Expenses>/vatEditMode} }" press=".onToggleVatEdit"/>
                                    <Button text="Guardar" type="Emphasized" visible="{Expenses>/vatEditMode}" press=".onToggleVatEdit"/>
                                </Toolbar>
                            </headerToolbar>

                            <columns>
                                <Column hAlign="Begin">
                                    <Text text="{i18n>xexp.expVatType}" />
                                </Column>
                                <Column hAlign="Middle">
                                    <Text text="{i18n>xexp.expBaseValue}" />
                                </Column>
                                <Column hAlign="Middle">
                                    <Text text="{i18n>xexp.expVatValue}" />
                                </Column>
                                <Column hAlign="Center" width="3rem">
                                    <Text text="" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <HBox renderType="Bare">
                                            <Text text="{Expenses>d}" visible="{= !${Expenses>/vatEditMode} }"/>
                                            <Select visible="{Expenses>/vatEditMode}" required="true" selectedKey="{Expenses>t}" items="{ path: '/ZFI_TAX_TYPES' }" change=".onVatTypeChange">
                                                <items>
                                                    <core:Item key="{DomvalueL}" text="{Ddtext}" />
                                                </items>
                                            </Select>
                                        </HBox>

                                        <HBox renderType="Bare">
                                            <Text text="{Expenses>b}" visible="{= !${Expenses>/vatEditMode} }"/>
                                            <Input type="Number" value="{Expenses>b}" visible="{Expenses>/vatEditMode}" placeholder="{i18n>xexp.expBaseValue}" required="true" change=".onVatCellChange"/>
                                        </HBox>

                                        <HBox renderType="Bare">
                                            <Text text="{Expenses>v}" visible="{= !${Expenses>/vatEditMode} }"/>
                                            <Input type="Number" value="{Expenses>v}" visible="{Expenses>/vatEditMode}" placeholder="{i18n>xexp.expVatValue}" required="true" change=".onVatCellChange"/>
                                        </HBox>

                                        <Button icon="sap-icon://delete" type="Transparent" visible="{Expenses>/vatEditMode}" press=".onDeleteVatLine"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <Label text="" visible="false"/>
                        <tnt:InfoLabel id="expenseDialog:messageStrip" text="{i18n>xexp.expFillFields}" colorScheme="2" visible="false"/>

                        <core:InvisibleText text=""/>
                        <Label text=""/>
                        <Text text="{i18n>xexp.expAttn}" class="sapMText sapUiSelectable sapUshellFlpSettingsHint"/>

                        <Label id="expenseDialog:labelAttachment" text="{i18n>xexp.expAttachment}" />
                        <HBox alignItems="Center" justifyContent="Start">
                            <u:FileUploader id="fileUploader" width="200px" visible="{= !${Expenses>/capturedImage} }" uploadOnChange="false" placeholder="{i18n>xexp.expSelectFile}" buttonText="{i18n>xexp.expBrowse}" change=".onFileSelected"/>
                            <Image src="{Expenses>/capturedImage}" width="230px" height="200px" visible="{= !!${Expenses>/capturedImage} }" class="sapUiTinyMarginBegin">
                                <detailBox>
                                    <LightBox>
                                        <LightBoxItem imageSrc="{Expenses>/capturedImage}"/>
                                    </LightBox>
                                </detailBox>
                            </Image>
                        </HBox>
                    </f:content>
                </f:SimpleForm>
            </VBox>

        </Page>
        <buttons>
            <Button text="{i18n>xexp.expSave}" type="Emphasized" press=".onFinishProcess" />
            <Button text="{i18n>xexp.expCancel}" press=".onCancelProcess(true)" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
