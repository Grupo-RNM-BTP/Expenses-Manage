<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="cropDialog" showHeader="false" horizontalScrolling="false" verticalScrolling="false" closeOnNavigation="true">

        <content>
            <core:HTML id="cropHTML" sanitizeContent="false" content='
                &lt;div class="cameraContainer" style="position:relative;width:100%;height:100%;overflow:hidden;background:#111"&gt;
                    &lt;img id="cameraImage" style="display:block;max-width:100%;max-height:100%;margin:auto;object-fit:contain;" /&gt;
                    &lt;canvas id="cameraOverlay" style="position:absolute;inset:0;pointer-events:auto;width:100%;height:100%;"&gt;&lt;/canvas&gt;
                &lt;/div&gt;' />
        </content>

        <beginButton>
            <Button text="{i18n>xexp.useFullPhoto}" press=".onUseFullPhoto"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>xexp.useCroppedPhoto}" type="Emphasized" press=".onUseCroppedPhoto"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>