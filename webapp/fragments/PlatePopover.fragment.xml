<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <ResponsivePopover id="platePopover" title="{i18n>xexp.colPlate}" class="sapUiContentPadding" placement="Auto" contentWidth="28rem">
        <Table id="plateTable" inset="false" fixedLayout="false" growing="true" growingThreshold="10" items="{Plate>/results}">
            <columns>
                <Column width="8rem">
                    <header>
                        <Text text="{i18n>xexp.colPlate}"/>
                    </header>
                </Column>

                <Column>
                    <header>
                        <Text text="{i18n>xexp.colOrder}"/>
                    </header>
                </Column>
            </columns>
            <items>
                <ColumnListItem>
                    <cells>
                        <Text text="{Plate>Plate}" />
                        <Text text="{Plate>Aufnr}" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ResponsivePopover>
</core:FragmentDefinition>
