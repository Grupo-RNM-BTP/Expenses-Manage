<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout">

    <Dialog id="DevolutionDialog" title="{i18n>Devolution}" contentWidth="1700px" contentHeight="650px" initialFocus="beginButton" class="sapUiSizeCompact sapUiNoContentPadding" stretchOnPhone="false" draggable="true" resizable="true">

        <VBox class="sapUiSmallMargin sapUiNoContentPadding">

            <MessageStrip text="{i18n>DevolutionMessage}" type="Information" showIcon="true" showCloseButton="false" class="sapUiSmallMarginBottom" />

            <OverflowToolbar design="Transparent" class="sapUiTinyMarginBottom">
                <SearchField width="22rem" placeholder="{i18n>Search}" liveChange=".onDevolutionSearchLiveChange" />
                <ToolbarSpacer />
                <Button icon="sap-icon://action-settings" type="Transparent" tooltip="{i18n>SortFilter}" press=".handleOpenDevolutionTableSettings" />
            </OverflowToolbar>

            <Table id="DevolutionTable" mode="SingleSelectLeft" inset="false" width="100%" demandPopin="true" class="sapUiResponsiveContentPadding" fixedLayout="false" growing="true" growingThreshold="7" items="{Main>/ExpenseDevolution}">
                <columns>
                    <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="7rem">
                        <Button type="Transparent" text="{i18n>ExpNo}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="ExpNo" />
                            </customData>
                        </Button>
                    </Column>
                    <Column minScreenWidth="Small" demandPopin="true">
                        <Button type="Transparent" text="{i18n>DocumentHeader}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="DocumentHeader" />
                            </customData>
                        </Button>
                    </Column>
                    <Column minScreenWidth="Small" demandPopin="true">
                        <Button type="Transparent" text="{i18n>ExpTypeDsc}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="ExpTypeDsc" />
                            </customData>
                        </Button>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Button type="Transparent" text="{i18n>PayMethodDsc}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="PayMethodDsc" />
                            </customData>
                        </Button>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
                        <Button type="Transparent" text="{i18n>Value}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="Value" />
                            </customData>
                        </Button>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true" hAlign="End">
                        <Button type="Transparent" text="{i18n>Sdate}" press=".onDevolutionColumnPress">
                            <customData>
                                <core:CustomData key="columnKey" value="VYearMonthDay" />
                            </customData>
                        </Button>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text text="{Main>ExpNo}" />
                            <Text text="{Main>DocumentHeader}" />
                            <Text text="{Main>ExpTypeDsc}" />
                            <Text text="{Main>PayMethodDsc}" />
                            <ObjectNumber number="{Main>Value}" unit="{Main>Waers}" />
                            <Text text="{Main>VYearMonthDay}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>

        <endButton>
            <Button text="{i18n>xexp.expCancel}" press=".onCancelDevolution" />
        </endButton>

        <beginButton>
            <Button text="{i18n>Devolution}" type="Emphasized" press=".onDevolution" />
        </beginButton>

    </Dialog>
</core:FragmentDefinition>
