<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="syncLogDialog" title="{i18n>SyncLogTitle}" icon="sap-icon://log" contentWidth="60rem" contentHeight="30rem" resizable="true" draggable="true">

        <content>
            <Table id="syncLogTable" inset="false" growing="true" growingScrollToLoad="true" width="100%" items="{
                    path: 'SyncLogs>/items',
                    sorter: [
                        {
                            path: 'LineNo',
                            descending: 'true'
                        }
                    ]
                }">

                <columns>
                    <Column width="10%" hAlign="Center">
                        <header>
                            <Label text="{i18n>SyncLogColLine}" textAlign="Center"/>
                        </header>
                    </Column>
                    <Column minScreenWidth="Tablet" width="10%" hAlign="Center">
                        <header>
                            <Label text="{i18n>SyncLogColType}" textAlign="Center"/>
                        </header>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" width="30%" hAlign="Center">
                        <header>
                            <Label text="{i18n>SyncLogColTimestamp}" textAlign="Center"/>
                        </header>
                    </Column>
                    <Column width="50%" hAlign="Begin">
                        <header>
                            <Label text="{i18n>SyncLogColDescription}" />
                        </header>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{SyncLogs>LineNo}" textAlign="Center"/>

                            <ObjectStatus text="{SyncLogs>Type}" state="{= ${SyncLogs>Type} === 'E' ? 'Error'
                                        : ${SyncLogs>Type} === 'W' ? 'Warning'
                                        : ${SyncLogs>Type} === 'S' ? 'Success'
                                        : ${SyncLogs>Type} === 'I' ? 'Information'
                                        : 'None' }" icon="{= ${SyncLogs>Type} === 'E' ? 'sap-icon://error'
                                        : ${SyncLogs>Type} === 'W' ? 'sap-icon://alert'
                                        : ${SyncLogs>Type} === 'S' ? 'sap-icon://accept'
                                        : ${SyncLogs>Type} === 'I' ? 'sap-icon://information'
                                        : '' }" />

                            <Text text="{SyncLogs>Timestamp}" textAlign="Center"/>

                            <Text text="{SyncLogs>Message}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="{i18n>btnClose}" press=".onCloseSyncLogDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
