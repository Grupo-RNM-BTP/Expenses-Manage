<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="syncLogDialog" title="{i18n>SyncLogTitle}" contentWidth="70%" contentHeight="60%" resizable="true" draggable="true">

        <content>
            <Table id="syncLogTable" inset="false" growing="true" growingScrollToLoad="true" items="{
                    path: 'SyncLogs>/items',
                    sorter: [
                        {
                            path: 'LineNo',
                            descending: 'false'
                        }
                    ]
                }">

                <!-- Cabeçalhos das colunas -->
                <columns>
                    <Column width="4rem">
                        <header>
                            <Label text="{i18n>SyncLogColLine}" />
                        </header>
                    </Column>
                    <Column width="6rem">
                        <header>
                            <Label text="{i18n>SyncLogColType}" />
                        </header>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" width="10rem">
                        <header>
                            <Label text="{i18n>SyncLogColTimestamp}" />
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <Label text="{i18n>SyncLogColMessage}" />
                        </header>
                    </Column>
                </columns>

                <!-- Linhas -->
                <items>
                    <ColumnListItem>
                        <cells>
                            <!-- Linha -->
                            <Text text="{SyncLogs>LineNo}" />

                            <!-- Tipo (I / S / E / F) com cor -->
                            <ObjectStatus text="{SyncLogs>Type}" state="{
                                    = ${SyncLogs>Type} === 'E' ? 'Error'
                                      : ${SyncLogs>Type} === 'S' ? 'Success'
                                      : ${SyncLogs>Type} === 'F' ? 'Information'
                                      : 'None'
                                }" />

                            <!-- Timestamp, se tiveres na entidade -->
                            <Text text="{SyncLogs>Timestamp}" />

                            <!-- Mensagem -->
                            <Text text="{SyncLogs>Message}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>

        <beginButton>
            <Button text="{i18n>Close}" press=".onCloseSyncLogDialog" />
        </beginButton>

    </Dialog>
</core:FragmentDefinition>
