<core:FragmentDefinition xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">
    <ValueHelpDialog title="{i18n>xexp.Projects}" ok=".handleProjectPress" cancel=".onProjectVhCancel" afterClose=".onProjectVhAfterClose" supportRanges="false" supportMultiselect="false" key="Network" descriptionKey="Project">
        <filterBar>
            <fb:FilterBar advancedMode="true" search=".handleProjectVhSearch" isRunningInValueHelpDialog="true">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="Network" label="{i18n>xexp.ProjectId}" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="Network" showValueHelp="false" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="Activity" label="{i18n>xexp.Activity}" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="Activity" showValueHelp="false" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="ActivityDesc" label="{i18n>xexp.ActivityDesc}" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="ActivityDesc" showValueHelp="false" />
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem groupName="__$INTERNAL$" name="Project" label="{i18n>xexp.ProjectName}" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input name="Project" showValueHelp="false" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>
    </ValueHelpDialog>
</core:FragmentDefinition>

