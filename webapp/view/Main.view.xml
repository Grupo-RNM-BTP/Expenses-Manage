<mvc:View controllerName="zfiexpensesmanage.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:card="sap.f.cards"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:tnt="sap.tnt"
    xmlns:layout="sap.ui.layout" height="100%">
    <tnt:ToolPage id="toolPage" sideExpanded="true">

        <tnt:header>
            <tnt:ToolHeader>
                <Button icon="sap-icon://menu2" press="onSideNavToggle"/>
                <Title text="{i18n>ManageMyExpenses}" />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation expanded="true" itemSelect=".onItemSelect">
                <tnt:NavigationList selectedKey="Manage">
                    <tnt:NavigationListItem text="{i18n>ManageExpenses}" key="Manage" icon="sap-icon://credit-card"/>
                    <tnt:NavigationListItem text="{i18n>OverviewExpenses}" key="CardMovements" icon="sap-icon://collections-insight"/>
                    <tnt:NavigationListItem id="idApproveExpenses" text="{i18n>ApproveExpenses}" visible="false" key="ApproveExpenses" icon="sap-icon://accept"/>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents >
            <NavContainer id="NavContainer" visible="true" initialPage="pageManage">
                <pages>

                    <ScrollContainer id="pageManage" visible="true" horizontal="false" vertical="true" height="100%">
                        <VBox class="sapUiMediumMarginBeginEnd">

                            <FlexBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop" wrap="Wrap" alignItems="Center">
                                <Title text="{i18n>OverviewExpenses}" titleStyle="H4" />
                            </FlexBox>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <l:Grid defaultSpan="XL4 L6 M12 S12" position="Center" hSpacing="1" vSpacing="1">
                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>SumOfApprovedExpenses}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idSumOfApprovedExpenses" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>

                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>SumOfExpensesNoAttach}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idSumOfExpensesNoAttach" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>

                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>SumOfExpensesLast30Days}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idSumOfExpensesLast30Days" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>
                            </l:Grid>

                            <FlexBox justifyContent="SpaceBetween" class="sapUiLargeMarginTop" wrap="Wrap" alignItems="Center">
                                <Title text="{i18n>AllExpenses}" titleStyle="H4" />
                            </FlexBox>

                            <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="ZFI_EXPENSES_MNG" persistencyKey="SmartFilterBar" />

                            <smartTable:SmartTable id="MyExpensesTable" entitySet="ZFI_EXPENSES_MNG" smartFilterId="idSmartFilterBar" beforeRebindTable="onBeforeRebindTable" demandPopin="true" persistencyKey='pKeyOperationsTable' width="100%" useExportToExcel="false" useTablePersonalisation="false" useVariantManagement="false" requestAtLeastFields="Doc,Reason,ExpNo,PayMethodDsc,ExpTypeDsc,Erdat,Value,Waers,FiStatus" placeToolbarInTable="true" useOnlyOneSolidToolbar="true" enableAutoBinding="true" tableType="ResponsiveTable" showVariantManagement="false" showTablePersonalisation="false">
                                <smartTable:customData>
                                    <core:CustomData key="p13nDialogSettings" value='\{"columns":\{"visible": true \},"sort":\{"visible": true\},"filter":\{"visible": false\},"group":\{"visible": true\}\}'/>
                                </smartTable:customData>
                                <smartTable:customToolbar>
                                    <OverflowToolbar design="Transparent">
                                        <ToolbarSpacer/>
                                        <Button id="deleteButton" text="{i18n>Delete}" enabled="false" type="Default" press="handleDelete" />
                                        <Button text="{i18n>New}" type="Emphasized" press="handleStartProcess" />
                                    </OverflowToolbar>
                                </smartTable:customToolbar>
                                <Table id="idTableExpenses" fixedLayout="false" growing="true" mode="SingleSelectLeft" selectionChange="handleSelectionChange" growingThreshold="10">
                                    <columns>
                                        <Column>
                                            <Text text="{i18n>Document}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>Reason}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>ExpensesNo}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>PaymentMethod}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>ExpenseType}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>Date}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>Value}" />
                                        </Column>
                                        <Column>
                                            <Text text="{i18n>Status}" />
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="idColumnListItem">
                                            <cells>
                                                <VBox>
                                                    <Avatar src="sap-icon://image-viewer" press="onPressAvatar" visible="{path: 'Doc', formatter: '.formatter.hasExpDoc'}" displayShape="Square" class="imgClass">
                                                        <detailBox>
                                                            <LightBox>
                                                            </LightBox>
                                                        </detailBox>
                                                    </Avatar>
                                                    <core:Icon visible="{path: 'Doc', formatter: '.formatter.noExpDoc'}" src="sap-icon://upload-to-cloud" size="3rem" press="onUploadPressed"/>
                                                </VBox>

                                                <VBox>
                                                    <core:Icon visible="{path: 'Reason', formatter: '.formatter.hasReason'}" src="sap-icon://comment" size="2rem" press="onPressReason" tooltip="{Reason}" />
                                                </VBox>
                                                <Link id="LinkDetail" text="{ExpNo}" press="handleExpensePress" />
                                                <Text id="Pymtmeth" text="{PayMethodDsc}" />
                                                <Text id="Exptype" text="{ExpTypeDsc}" />
                                                <Text text="{path: 'Erdat', formatter: '.formatter.formatDateTime'}" />
                                                <Text id="Totalvalue" text="{Value} {Waers}" />
                                                <ObjectStatus text="{path: 'FiStatus', formatter: '.formatter.statusText'}" state="{path: 'FiStatus', formatter: '.formatter.statusState'}" icon="{path: 'FiStatus', formatter: '.formatter.statusIcon'}" iconDensityAware="false" active="false"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </smartTable:SmartTable>
                        </VBox>
                    </ScrollContainer>

                    <ScrollContainer id="pageCardMovements" horizontal="false" vertical="true" height="100%">
                        <VBox class="sapUiMediumMarginBeginEnd">

                            <FlexBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop" wrap="Wrap" alignItems="Center">
                                <Title text="{i18n>OverView}" titleStyle="H4" />
                            </FlexBox>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <layout:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="4" vSpacing="4" class="sapUiResponsiveMargin sapUiSmallMarginTopBottom">
                                <layout:content>
                                    <f:Card class="sapUiSmallMargin" width="100%">
                                        <f:content>
                                            <VBox class="sapUiSmallMargin" width="100%">
                                                <viz:VizFrame id="barChart" width="100%" height="400px" uiConfig="{applicationSet:'fiori'}" vizType="bar" vizProperties='{ "legend": { "visible": false },"title": { "visible": true }, "plotArea": { "dataLabel": { "visible": true } } }'>
                                                    <viz:dataset>
                                                        <viz.data:FlattenedDataset data="{graficoModel>/gastosPorMes}">
                                                            <viz.data:dimensions>
                                                                <viz.data:DimensionDefinition name="Mes" value="{path: 'graficoModel>YearMonth', formatter: '.formatter.formatYearMonth'}" />
                                                            </viz.data:dimensions>
                                                            <viz.data:measures>
                                                                <viz.data:MeasureDefinition name="Valor" value="{graficoModel>Amount}" />
                                                            </viz.data:measures>
                                                        </viz.data:FlattenedDataset>
                                                    </viz:dataset>
                                                    <viz:feeds>
                                                        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Valor" />
                                                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Mes" />
                                                    </viz:feeds>
                                                </viz:VizFrame>

                                                <FlexBox class="sapUiMediumMarginTop" wrap="Wrap" justifyContent="SpaceAround" alignItems="Stretch">
                                                    <VBox class="sapUiSmallMargin" width="30%">
                                                        <Title text="{i18n>TotalYear}" wrapping="true" titleStyle="H5" />
                                                        <Title level="H2" wrapping="true" titleStyle="H3" text="{= ${graficoModel>/totalAno} + ' €'}" />
                                                    </VBox>
                                                    <VBox class="sapUiSmallMargin" width="30%">
                                                        <Title text="{i18n>ExpensesMonth}" wrapping="true" titleStyle="H5" />
                                                        <Title level="H2" wrapping="true" titleStyle="H3" text="{= ${graficoModel>/gastoMesAtual} + ' €'}" />
                                                    </VBox>
                                                </FlexBox>
                                            </VBox>
                                        </f:content>
                                    </f:Card>
                                </layout:content>
                            </layout:Grid>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <smartTable:SmartTable id="smartTable" beforeRebindTable="onBeforeRebindTableCards" entitySet="ZFI_BCP_MOVCC" tableType="ResponsiveTable" useExportToExcel="false" demandPopin="true" useVariantManagement="false" useTablePersonalisation="true" header="{i18n>AllMovements}" showRowCount="true" persistencyKey="SmartTable" enableAutoBinding="true" class="sapUiResponsiveContentPadding">
                                <Table mode="None" growing="true" growingThreshold="50">
                                    <ColumnListItem vAlign="Middle">
                                    </ColumnListItem>
                                </Table>
                            </smartTable:SmartTable>
                        </VBox>
                    </ScrollContainer>

                    <ScrollContainer id="pageApprovals" horizontal="false" vertical="true" height="100%">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBarApprovals" entitySet="ZFI_EXPENSES_LAPPRVD" persistencyKey="SmartFilterBarApprovals"/>

                        <smartTable:SmartTable id="smartTableApprovals" entitySet="ZFI_EXPENSES_LAPPRVD" beforeRebindTable="onBeforeRebindTableApprovals" demandPopin="true" smartFilterId="idSmartFilterBarApprovals" persistencyKey='pKeyOperationsTable' width="100%" useExportToExcel="false" useTablePersonalisation="false" useVariantManagement="false" requestAtLeastFields="Pernr,CompanyCode,CompanyDsc,Doc,Reason,ExpNo,Belnr,PayMethodDsc,ExpTypeDsc,Erdat,Value,Waers,FiStatus,FirstName,LastName,FiscalYear,Nif" showVariantManagement="false" placeToolbarInTable="true" useOnlyOneSolidToolbar="true" enableAutoBinding="true" tableType="ResponsiveTable" showTablePersonalisation="false">
                            <smartTable:customData>
                                <core:CustomData key="p13nDialogSettings" value='\{"columns":\{"visible": true \},"sort":\{"visible": true\},"filter":\{"visible": false\},"group":\{"visible": true\}\}'/>
                            </smartTable:customData>
                            <smartTable:customToolbar>
                                <OverflowToolbar design="Transparent">
                                    <ToolbarSpacer/>
                                    <Button icon="sap-icon://accept" text="{i18n>Approve}" type="Emphasized" press="onGetItemsTable('A')" />
                                    <Button icon="sap-icon://decline" text="{i18n>Reject}" type="Default" press="onGetItemsTable('R')" />
                                </OverflowToolbar>
                            </smartTable:customToolbar>
                            <Table id="idTableApprovals" fixedLayout="false" class="sapUiResponsiveContentPadding" mode="MultiSelect" selectionChange="onSelectionChangeApprovals" growing="true" growingThreshold="10">
                                <columns>
                                    <Column>
                                        <Text text="{i18n>Document}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>NamePernr}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>Company}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>ExpNoAndDocNo}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>PaymentMethod}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>ExpenseType}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>Date}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>Value}" />
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>Status}" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="idColumnListItemApprovals">
                                        <cells>
                                            <VBox>
                                                <Avatar src="sap-icon://image-viewer" press="onPressAvatar" visible="{path: 'Doc', formatter: '.formatter.hasExpDoc'}" displayShape="Square" class="imgClass">
                                                    <detailBox>
                                                        <LightBox>
                                                        </LightBox>
                                                    </detailBox>
                                                </Avatar>
                                                <core:Icon visible="{path: 'Doc', formatter: '.formatter.noExpDocApprvd'}" src="sap-icon://sys-cancel" size="2rem"/>
                                            </VBox>
                                            <Text text="{FirstName} {LastName} ({Pernr})" />
                                            <Text text="{CompanyDsc} ({CompanyCode})" />
                                            <Text text="{ExpNo} / {Belnr}" />
                                            <Text text="{PayMethodDsc}" />
                                            <Text text="{ExpTypeDsc}" />
                                            <Text text="{path: 'Erdat', formatter: '.formatter.formatDateTime'}" />
                                            <Text text="{Value} {Waers}" />
                                            <ObjectStatus text="{path: 'FiStatus', formatter: '.formatter.statusText'}" state="{path: 'FiStatus', formatter: '.formatter.statusState'}" icon="{path: 'FiStatus', formatter: '.formatter.statusIcon'}" iconDensityAware="false" active="false"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </smartTable:SmartTable>
                    </ScrollContainer>
                </pages>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View> 
