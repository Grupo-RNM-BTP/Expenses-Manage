<mvc:View controllerName="zfiexpensesmanage.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:customData="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    xmlns:card="sap.f.cards"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.data="sap.viz.ui5.data"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:tnt="sap.tnt"
    xmlns:layout="sap.ui.layout" height="100%">
    <tnt:ToolPage id="toolPage" sideExpanded="true">

        <tnt:header>
            <tnt:ToolHeader>
                <Button icon="sap-icon://menu2" press="onSideNavToggle"/>
                <Title id="idTitle1" />
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation expanded="true" itemSelect=".onItemSelect">
                <tnt:NavigationList selectedKey="Manage">
                    <tnt:NavigationListItem text="{i18n>ManageExpenses}" key="Manage" icon="sap-icon://credit-card"/>
                    <tnt:NavigationListItem text="{i18n>OverviewExpenses}" key="CardMovements" icon="sap-icon://collections-insight"/>
                    <tnt:NavigationListItem text="{i18n>TransactionReconciliation}" key="TransRecon" icon="sap-icon://unpaid-leave"/>
                    <tnt:NavigationListItem text="{i18n>CurrentAccount}" key="CurrentAccount" icon="sap-icon://order-status"/>
                    <tnt:NavigationListItem id="idApproveExpenses" text="{i18n>ApproveExpenses}" visible="false" key="ApproveExpenses" icon="sap-icon://accept"/>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents >
            <NavContainer id="NavContainer" visible="true" initialPage="pageManage">
                <pages>

                    <ScrollContainer id="pageManage" visible="true" horizontal="false" vertical="true" height="100%">
                        <VBox class="sapUiMediumMarginBeginEnd">

                            <FlexBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop" wrap="Wrap" alignItems="Center">
                                <Title text="{i18n>OverviewExpenses}" titleStyle="H4" />
                            </FlexBox>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <l:Grid defaultSpan="XL4 L6 M12 S12" position="Center" hSpacing="1" vSpacing="1">

                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>SumOfApprovedExpenses}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idSumOfApprovedExpenses" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>

                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>SumOfExpensesLast30Days}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idSumOfExpensesLast30Days" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>

                                <f:Card class="sapUiSmallMargin">
                                    <f:header>
                                        <card:Header title="{i18n>NoTheExpensesNonReconciled}" />
                                    </f:header>
                                    <f:content>
                                        <VBox class="sapUiSmallMargin">
                                            <Title id="idNoTheExpensesNonReconciled" level="H2" titleStyle="H3" />
                                        </VBox>
                                    </f:content>
                                </f:Card>
                            </l:Grid>

                            <smartFilterBar:SmartFilterBar id="idSmartFilterBar" entitySet="ZFI_EXPENSES_MNG" />
                            <smartTable:SmartTable id="MyExpensesTable" demandPopin="true" showRowCount="false" enableAutoBinding="true" entitySet="ZFI_EXPENSES_MNG" persistencyKey='pKeyOperationsTable' useVariantManagement="false" smartFilterId="idSmartFilterBar" tableType="ResponsiveTable" beforeRebindTable="onBeforeRebindTable" useExportToExcel="false" width="100%" useTablePersonalisation="true" requestAtLeastFields="Doc,Reason,ExpNo,ApprvdValue,PayMethodDsc,ExpTypeDsc,Erdat,Value,Waers,FiStatus">
                                <smartTable:customToolbar>
                                    <OverflowToolbar design="Transparent">
                                        <ToolbarSpacer/>
                                        <Button text="{i18n>New}" type="Emphasized" press="handleStartProcess" />
                                        <Button id="deleteButton" text="{i18n>Delete}" enabled="false" type="Default" press="handleDelete" />
                                    </OverflowToolbar>
                                </smartTable:customToolbar>
                                <Table id="idTableExpenses" fixedLayout="false" growing="true" mode="SingleSelectLeft" selectionChange="handleSelectionChange" growingThreshold="10">
                                    <columns>
                                        <Column customData:p13nData='{"columnKey":"Doc", "leadingProperty":"Doc", "sortProperty":"Doc", filterProperty:"Doc"}'>
                                            <header>
                                                <Text text="{i18n>Document}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"ExpNo", "leadingProperty":"ExpNo", "sortProperty":"ExpNo", filterProperty:"ExpNo"}'>
                                            <header>
                                                <Text text="{i18n>ExpensesNo}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"PayMethodDsc", "leadingProperty":"PayMethodDsc", "sortProperty":"PayMethodDsc", filterProperty:"PayMethodDsc"}'>
                                            <header>
                                                <Text text="{i18n>PaymentMethod}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"ExpTypeDsc", "leadingProperty":"ExpTypeDsc", "sortProperty":"ExpTypeDsc", filterProperty:"ExpTypeDsc"}'>
                                            <header>
                                                <Text text="{i18n>ExpenseType}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"Erdat", "leadingProperty":"Erdat", "sortProperty":"Erdat", filterProperty:"Erdat"}'>
                                            <header>
                                                <Text text="{i18n>Date}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"Value", "leadingProperty":"Value", "sortProperty":"Value", filterProperty:"Value"}'>
                                            <header>
                                                <Text text="{i18n>SubmittedValue}" />
                                            </header>
                                        </Column>
                                        <Column customData:p13nData='{"columnKey":"ApprvdValue", "leadingProperty":"ApprvdValue", "sortProperty":"ApprvdValue", filterProperty:"ApprvdValue"}'>
                                            <header>
                                                <Text text="{i18n>PostedValue}" />
                                            </header>
                                        </Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="idColumnListItem">
                                            <cells>
                                                <VBox>
                                                    <Avatar src="sap-icon://image-viewer" press="onPressAvatar" visible="{path: 'Doc', formatter: '.formatter.hasExpDoc'}" displayShape="Square" class="imgClass">
                                                        <detailBox>
                                                            <LightBox>
                                                            </LightBox>
                                                        </detailBox>
                                                    </Avatar>
                                                    <core:Icon visible="{path: 'Doc', formatter: '.formatter.noExpDoc'}" src="sap-icon://upload-to-cloud" size="3rem" press="onUploadPressed"/>
                                                </VBox>
                                                <Link id="LinkDetail" text="{ExpNo}" press="handleExpensePress" />
                                                <Text id="Pymtmeth" text="{PayMethodDsc}" />
                                                <Text id="Exptype" text="{ExpTypeDsc}" />
                                                <Text text="{path: 'Erdat', formatter: '.formatter.formatDateTime'}" />
                                                <Text id="Totalvalue" text="{parts: [{path: 'Value'}, {path: 'Waers'}], formatter: '.formatter.formatValue'}" />
                                                <Text id="ApprovedValue" text="{parts: [{path: 'ApprvdValue'}, {path: 'Waers'}], formatter: '.formatter.formatValue'}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </smartTable:SmartTable>
                        </VBox>
                    </ScrollContainer>

                    <ScrollContainer id="pageCardMovements" horizontal="false" vertical="true" height="100%">
                        <VBox class="sapUiMediumMarginBeginEnd">

                            <FlexBox justifyContent="SpaceBetween" class="sapUiMediumMarginTop" wrap="Wrap" alignItems="Center">
                                <Title text="{i18n>OverView}" titleStyle="H4" />
                            </FlexBox>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <layout:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="4" vSpacing="4" class="sapUiResponsiveMargin sapUiSmallMarginTopBottom">
                                <layout:content>
                                    <f:Card class="sapUiSmallMargin" width="100%">
                                        <f:content>
                                            <VBox class="sapUiSmallMargin" width="100%">
                                                <viz:VizFrame id="barChart" width="100%" height="400px" uiConfig="{applicationSet:'fiori'}" vizType="bar" vizProperties='{ "legend": { "visible": false },"title": { "visible": true }, "plotArea": { "dataLabel": { "visible": true } } }'>
                                                    <viz:dataset>
                                                        <viz.data:FlattenedDataset data="{graficoModel>/gastosPorMes}">
                                                            <viz.data:dimensions>
                                                                <viz.data:DimensionDefinition name="Mes" value="{path: 'graficoModel>YearMonth', formatter: '.formatter.formatYearMonth'}" />
                                                            </viz.data:dimensions>
                                                            <viz.data:measures>
                                                                <viz.data:MeasureDefinition name="Valor" value="{graficoModel>Amount}" />
                                                            </viz.data:measures>
                                                        </viz.data:FlattenedDataset>
                                                    </viz:dataset>
                                                    <viz:feeds>
                                                        <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="Valor" />
                                                        <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Mes" />
                                                    </viz:feeds>
                                                </viz:VizFrame>

                                                <FlexBox class="sapUiMediumMarginTop" wrap="Wrap" justifyContent="SpaceAround" alignItems="Stretch">
                                                    <VBox class="sapUiSmallMargin" width="30%">
                                                        <Title text="{i18n>TotalYear}" wrapping="true" titleStyle="H5" />
                                                        <Title level="H2" wrapping="true" titleStyle="H3" text="{= ${graficoModel>/totalAno} + ' €'}" />
                                                    </VBox>
                                                    <VBox class="sapUiSmallMargin" width="30%">
                                                        <Title text="{i18n>ExpensesMonth}" wrapping="true" titleStyle="H5" />
                                                        <Title level="H2" wrapping="true" titleStyle="H3" text="{= ${graficoModel>/gastoMesAtual} + ' €'}" />
                                                    </VBox>
                                                </FlexBox>
                                            </VBox>
                                        </f:content>
                                    </f:Card>
                                </layout:content>
                            </layout:Grid>

                            <Toolbar style="Standard" design="Transparent" height="0.1rem" />

                            <smartFilterBar:SmartFilterBar id="sfbMovCC" entitySet="ZFI_BCP_MOVCC" />

                            <smartTable:SmartTable id="smartTable" beforeRebindTable="onBeforeRebindTableCards" smartFilterId="sfbMovCC" entitySet="ZFI_BCP_MOVCC" tableType="ResponsiveTable" useExportToExcel="true" demandPopin="true" useVariantManagement="false" useTablePersonalisation="true" header="{i18n>AllMovements}" showRowCount="true" enableAutoBinding="true" class="sapUiResponsiveContentPadding">
                                <smartTable:customToolbar>
                                    <OverflowToolbar design="Transparent">
                                        <ToolbarSpacer/>
                                        <Button text="{i18n>Synchronize}" icon="sap-icon://synchronize" enabled="true" type="Emphasized" press="handleSynchronize" />
                                    </OverflowToolbar>
                                </smartTable:customToolbar>
                                <Table mode="None" growing="true" growingThreshold="50">
                                    <ColumnListItem vAlign="Middle">
                                    </ColumnListItem>
                                </Table>
                            </smartTable:SmartTable>
                        </VBox>
                    </ScrollContainer>

                    <ScrollContainer id="pageTransRecon" horizontal="false" vertical="true" height="100%">
                        <smartFilterBar:SmartFilterBar id="sfbReconCC" entitySet="ZFI_EXPENSES_RECON" />

                        <smartTable:SmartTable id="smartTableTransRecon" entitySet="ZFI_EXPENSES_RECON" smartFilterId="sfbReconCC" beforeRebindTable="onBeforeRebindTableRecon" tableType="ResponsiveTable" demandPopin="true" useVariantManagement="false" useExportToExcel="false" useTablePersonalisation="true" persistencyKey="SmartTable" enableAutoBinding="true" class="sapUiResponsiveContentPadding">
                            <smartTable:customToolbar>
                                <OverflowToolbar design="Transparent">
                                    <ToolbarSpacer/>
                                    <Button id="idExpensesWithoutAttach" text="{i18n>ExpensesWithoutAttach}" enabled="false" type="Emphasized" press="handleExpenseWithoutAttach" />
                                    <Button id="idReconcile" text="{i18n>Reconcile}" enabled="false" type="Default" press="handleReconcile" />
                                    <Button id="idCompensation" text="{i18n>Compensation}" enabled="false" type="Default" press="handleCompensation" />
                                </OverflowToolbar>
                            </smartTable:customToolbar>
                            <Table class="sapUiResponsiveContentPadding" mode="MultiSelect" selectionChange="onSelectionChangeRecon" growing="true" growingThreshold="50">
                                <ColumnListItem vAlign="Middle">
                                </ColumnListItem>
                            </Table>
                        </smartTable:SmartTable>
                    </ScrollContainer>

                    <ScrollContainer id="pageCurrentAccount" horizontal="false" vertical="true" height="100%">
                        <layout:Grid defaultSpan="L6 M12 S12" width="100%" vSpacing="1" hSpacing="1">
                            <layout:content>
                                <smartTable:SmartTable id="smartTableCurrentAccount_1" entitySet="ZFI_EXPENSES_CURRENTE_ACC_1" tableType="ResponsiveTable" demandPopin="true" useExportToExcel="false" useVariantManagement="false" useTablePersonalisation="true" header="{i18n>CurrentAccount_1}" showRowCount="true" persistencyKey="123" enableAutoBinding="true" class="sapUiResponsiveContentPadding">
                                    <Table class="sapUiResponsiveContentPadding" growing="true" growingThreshold="50">
                                        <ColumnListItem vAlign="Middle">
                                        </ColumnListItem>
                                    </Table>
                                </smartTable:SmartTable>
                            </layout:content>
                            <layout:content>
                                <smartTable:SmartTable id="smartTableCurrentAccount_2" entitySet="ZFI_EXPENSES_CURRENTE_ACC_2" tableType="ResponsiveTable" demandPopin="true" useExportToExcel="false" useVariantManagement="false" useTablePersonalisation="true" header="{i18n>CurrentAccount_2}" showRowCount="true" persistencyKey="1234" enableAutoBinding="true" class="sapUiResponsiveContentPadding">
                                    <Table class="sapUiResponsiveContentPadding" growing="true" growingThreshold="50">
                                        <ColumnListItem vAlign="Middle">
                                        </ColumnListItem>
                                    </Table>
                                </smartTable:SmartTable>
                            </layout:content>
                        </layout:Grid>
                    </ScrollContainer>

                    <ScrollContainer id="pageApprovals" horizontal="false" vertical="true" height="100%">
                        <smartFilterBar:SmartFilterBar id="idSmartFilterBarApprovals" entitySet="ZFI_EXPENSES_LAPPRVD" />

                        <smartTable:SmartTable id="smartTableApprovals" entitySet="ZFI_EXPENSES_LAPPRVD" beforeRebindTable="onBeforeRebindTableApprovals" demandPopin="true" smartFilterId="idSmartFilterBarApprovals" persistencyKey='pKeyOperationsTable' width="100%" useExportToExcel="true" useTablePersonalisation="true" useVariantManagement="false" requestAtLeastFields="Pernr,CompanyCode,CompanyDsc,Doc,Reason,ExpNo,Belnr,PayMethodDsc,ExpTypeDsc,Erdat,Value,Waers,FiStatus,FirstName,LastName,FiscalYear,Nif" showVariantManagement="false" placeToolbarInTable="true" useOnlyOneSolidToolbar="true" enableAutoBinding="true" tableType="ResponsiveTable" showTablePersonalisation="true">
                            <smartTable:customToolbar>
                                <OverflowToolbar design="Transparent">
                                    <ToolbarSpacer/>
                                    <Button id="partialApprovalButton" enabled="false" text="{i18n>PartialApproval}" type="Default" press="handleOpenDialog" />
                                    <Button id="approveButton" enabled="false" icon="sap-icon://accept" text="{i18n>Approve}" type="Emphasized" press="onGetItemsTable('A')" />
                                    <Button id="rejectButton" enabled="false" icon="sap-icon://decline" text="{i18n>Reject}" type="Emphasized" press="onGetItemsTable('R')" />
                                </OverflowToolbar>

                            </smartTable:customToolbar>
                            <Table id="idTableApprovals" fixedLayout="false" class="sapUiResponsiveContentPadding" mode="MultiSelect" selectionChange="onSelectionChangeApprovals" growing="true" growingThreshold="10">
                                <columns>
                                    <Column customData:p13nData='{"columnKey":"Doc", "leadingProperty":"Doc", "sortProperty":"Doc", filterProperty:"Doc"}'>
                                        <header>
                                            <Text text="{i18n>Document}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"Pernr", "leadingProperty":"Pernr", "sortProperty":"Pernr", filterProperty:"Pernr"}'>
                                        <header>
                                            <Text text="{i18n>NamePernr}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"CompanyCode", "leadingProperty":"CompanyCode", "sortProperty":"CompanyCode", filterProperty:"CompanyCode"}'>
                                        <header>
                                            <Text text="{i18n>Company}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"ExpNo", "leadingProperty":"ExpNo", "sortProperty":"ExpNo", filterProperty:"ExpNo"}'>
                                        <header>
                                            <Text text="{i18n>ExpNoAndDocNo}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"ExpTypeDsc", "leadingProperty":"ExpTypeDsc", "sortProperty":"ExpTypeDsc", filterProperty:"ExpTypeDsc"}'>
                                        <header>
                                            <Text text="{i18n>ExpenseType}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"PayMethodDsc", "leadingProperty":"PayMethodDsc", "sortProperty":"PayMethodDsc", filterProperty:"PayMethodDsc"}'>
                                        <header>
                                            <Text text="{i18n>PaymentMethod}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"Reason", "leadingProperty":"Reason", "sortProperty":"Reason", filterProperty:"Reason"}'>
                                        <header>
                                            <Text text="{i18n>Reason}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"Erdat", "leadingProperty":"Erdat", "sortProperty":"Erdat", filterProperty:"Erdat"}'>
                                        <header>
                                            <Text text="{i18n>Date}" />
                                        </header>
                                    </Column>
                                    <Column customData:p13nData='{"columnKey":"Value", "leadingProperty":"Value", "sortProperty":"Value", filterProperty:"Value"}'>
                                        <header>
                                            <Text text="{i18n>Value}" />
                                        </header>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem id="idColumnListItemApprovals">
                                        <cells>
                                            <VBox>
                                                <Avatar src="sap-icon://image-viewer" press="onPressAvatar" visible="{path: 'Doc', formatter: '.formatter.hasExpDoc'}" displayShape="Square" class="imgClass">
                                                    <detailBox>
                                                        <LightBox>
                                                        </LightBox>
                                                    </detailBox>
                                                </Avatar>
                                                <core:Icon visible="{path: 'Doc', formatter: '.formatter.noExpDocApprvd'}" src="sap-icon://sys-cancel" size="2rem"/>
                                            </VBox>
                                            <Text text="{FirstName} {LastName} ({Pernr})" />
                                            <Text text="{CompanyDsc} ({CompanyCode})" />
                                            <Text text="{ExpNo} / {Belnr}" />
                                            <Text text="{ExpTypeDsc}" />
                                            <Text text="{PayMethodDsc}" />
                                            <Text text="{Reason}" />
                                            <Text text="{path: 'Erdat', formatter: '.formatter.formatDateTime'}" />
                                            <Text text="{Value} {Waers}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </smartTable:SmartTable>
                    </ScrollContainer>
                </pages>
            </NavContainer>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View> 
